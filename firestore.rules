rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /userData/{userId} {
      // La raíz de v5.5 solo guarda configuración pequeña. Exigir la versión
      // impide que un cliente antiguo vuelva a escribir todo el historial aquí.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.cloudSchemaVersion == 2;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Un documento por fecha: elimina el crecimiento hacia el límite de 1 MiB
      // y permite detectar conflictos por día en lugar de por cuenta completa.
      match /days/{dayId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Solo se usa para comprobar que la migración puede escribir subcolecciones.
      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
